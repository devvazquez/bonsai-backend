# Proveïdor de visió per defecte: "groq" o "gemini".
# Groq perquè és el més ràpid i el més regular: 552 ms de visió (551-554)
# contra els 844 ms de Gemini (649-937), amb la mateixa imatge.
# Es pot demanar l'altre a cada petició amb el camp "provider" de /look.
VISION_PROVIDER=groq

# Clau de l'API de Groq (https://console.groq.com)
# Compte amb la quota: 8.000 tokens/minut són unes 3 fotos per minut a 896 px,
# i el límit és per organització, no per clau.
GROQ_API_KEY=la-teva-api-key-de-groq

# OJO amb /ask: la transcripció SEMPRE va per Groq, encara que la visió vagi
# per Gemini, així que sense GROQ_API_KEY /ask torna 500. La bona notícia és
# que Whisper es factura per segons d'àudio i no per tokens: transcriure NO et
# gasta els 200.000 tokens/dia que sí que gasten les fotos.

# Clau de Gemini (https://aistudio.google.com/apikey). Opcional: només cal si
# demanes "provider": "gemini". La seva quota és molt més folgada (250.000
# tokens/minut), així que va bé per desenvolupar sense barallar-se amb el 429.
# OJO: a la capa gratuïta, Google entrena amb el que li envies.
GEMINI_API_KEY=

# Motor de veu: "piper" (en local, ~205 ms) o "edge" (Microsoft, ~1.320 ms amb
# text nou, però la veu sona millor). Es pot demanar l'altre a cada petició amb
# el camp "tts". Piper no necessita cap clau.
TTS_PROVIDER=piper

# On viuen els models .onnx del Piper. Es baixen sols: la veu de l'idioma per
# defecte quan arrenca el servidor (63 MB la catalana) i la dels altres idiomes
# el primer cop que algú els demana. Quina veu té cada idioma es tria al codi,
# a piper_tts.VOICES.
# PIPER_VOICES_DIR=./voices

# Token per protegir l'API. Genera'l amb:
#   openssl rand -hex 32
# Sense això, qualsevol que descobreixi la URL pot gastar la teva quota.
BONSAI_API_TOKEN=

# Contrasenya del panell /admin, que és accés SQL complet a la base de dades.
# Si es deixa buida la ruta ni tan sols es munta (torna 404), que és el que
# convé si no la fas servir. Genera-la igual que el token:
#   openssl rand -hex 16
ADMIN_PASSWORD=

# Domini per a l'HTTPS automàtic (només si fas servir el perfil "caddy")
BONSAI_DOMAIN=bonsai.eldomini.com

# Orígens CORS permesos. Les pàgines /provar i /memoria les serveix el mateix
# backend, i l'ESP32 no fa CORS, així que això només importa si algun dia hi ha
# una aplicació web separada.
ALLOWED_ORIGINS=*

# Opcional: canviar els models sense tocar el codi
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite   # més qualitat: gemini-3.5-flash

# Opcional: raonament de Gemini. "minimal" és el que interessa. Amb "medium"
# el model gasta ~140 tokens pensant, esgota maxOutputTokens i torna la frase
# tallada a mitja paraula (mesurat).
# GEMINI_THINKING_LEVEL=minimal

# Opcional: quants tokens gasta la imatge a Gemini. Compte, aquí la mida de la
# imatge NO canvia el preu (Gemini cobra pla: 1.108 tokens mesurats tant a
# 256x170 com a 2400x1597). Això sí que el canvia:
#   LOW     286 tokens  — però va perdre precisió a les proves
#   MEDIUM  577 tokens  — mateixa resposta que HIGH a la foto provada
#   HIGH  1.133 tokens  — el que fa servir l'API si no dius res
# GEMINI_MEDIA_RESOLUTION=MEDIUM

# Reduir la foto al servidor abans d'enviar-la al proveïdor. Compensa amb els
# dos: a Groq li baixa la factura (cobra per píxels) i a Gemini la latència
# (2.342 ms -> 988 ms mesurats amb una foto de 12 MP). Costa ~192 ms de CPU.
# IMAGE_MAX_SIDE=896            # 0 ho desactiva
# IMAGE_RESIZE_FOR=groq,gemini
# IMAGE_JPEG_QUALITY=80

# Opcional: model de transcripció de /ask. Ha de ser un dels de Groq.
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Opcional: topalls de /ask. El de l'àudio no és només memòria: Whisper cobra
# per segons, així que un micròfon que es quedi obert no ha de poder cremar la
# quota del dia. 30 s és molt més del que dura una pregunta.
# ASK_MAX_AUDIO_SECONDS=30
# ASK_MAX_IMAGE_BYTES=8388608

# Opcional: on van les fotos de /ask i quantes se'n guarden per dispositiu.
# Per defecte, una carpeta "captures" al costat de la base de dades (dins del
# volum, o sigui que sobreviuen a les actualitzacions del contenidor).
# BONSAI_CAPTURES_DIR=/data/captures
# BONSAI_MAX_CAPTURES=100

# Els dos torns de conversa que se li donen per dits al model abans de la foto
# i la pregunta, a /ask. Han de coincidir amb el que fa el firmware: la
# paraula d'activació que detecta i el clip que sona mentre puja la foto. Si
# canvies el clip i no canvies això, li expliques al model una conversa que no
# ha passat.
# ASK_WAKE_PHRASE=Hey Bonsai!
# ASK_WAKE_REPLY=Diga’m!

# Quant s'espera sense rebre ni un tros del micròfon abans de donar la petició
# per perduda (408). Hi han de cabre el clip del "Diga'm" i el que la persona
# trigui a arrencar a parlar. És per tros, no total.
# ASK_SILENCE_TIMEOUT_SECONDS=15
