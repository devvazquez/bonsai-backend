# Proveedor de visión por defecto: "gemini" o "groq".
# Gemini porque su capa gratuita es mucho más holgada (250.000 tokens/minuto y
# 1.500 peticiones/día frente a 8.000 y 200.000/día de Groq). Se puede pedir
# el otro en cada petición con el campo "provider" de /describe.
# OJO: en la capa gratuita de Google, Google entrena con lo que le mandas.
VISION_PROVIDER=gemini

# Clave de la API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu-api-key-de-gemini

# Clave de la API de Groq (https://console.groq.com)
GROQ_API_KEY=tu-api-key-de-groq

# Motor de voz: "piper" (en local, ~205 ms) o "edge" (Microsoft, ~1.320 ms con
# texto nuevo, pero la voz suena mejor). Se puede pedir el otro en cada
# petición con el campo "tts" de /describe.
TTS_PROVIDER=piper

# Dónde viven los modelos .onnx de Piper. Se bajan solos la primera vez que
# arranca el servidor (63 MB la voz catalana), o antes con:
#   python descargar_voces.py
# PIPER_VOICES_DIR=./voices

# Token para proteger el endpoint. Genéralo con:
#   openssl rand -hex 32
# Sin esto, cualquiera que descubra la URL puede gastar tu cuota.
BONSAI_API_TOKEN=

# Dominio para el HTTPS automático (solo si usas el perfil "caddy")
BONSAI_DOMAIN=bonsai.tudominio.com

# Orígenes permitidos para el navegador. En producción, mejor el dominio
# concreto de tu app web en vez de "*".
ALLOWED_ORIGINS=*

# Opcional: cambiar los modelos sin tocar el código
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite   # más calidad: gemini-3.5-flash
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Opcional: razonamiento de Gemini. "minimal" es lo que interesa aquí. Con
# "medium" el modelo gasta ~140 tokens pensando, agota maxOutputTokens y
# devuelve la frase cortada a media palabra (medido).
# Valores: minimal, low, medium, high
# GEMINI_THINKING_LEVEL=minimal

# Opcional: cuántos tokens gasta la imagen en Gemini. Ojo, aquí el tamaño de la
# imagen NO cambia el precio (Gemini cobra plano: 1.108 tokens medidos tanto a
# 256x170 como a 2400x1597). Esto sí lo cambia:
#   LOW     286 tokens  — pero perdió precisión en las pruebas
#   MEDIUM  577 tokens  — misma respuesta que HIGH en la foto probada
#   HIGH  1.133 tokens  — lo que usa la API si no dices nada
# GEMINI_MEDIA_RESOLUTION=MEDIUM
