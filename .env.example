# Clave de la API de Groq (https://console.groq.com)
GROQ_API_KEY=tu-api-key-de-groq

# Token para proteger el endpoint. Genéralo con:
#   openssl rand -hex 32
# Sin esto, cualquiera que descubra la URL puede gastar tu cuota de Groq.
BONSAI_API_TOKEN=

# Dominio para el HTTPS automático (solo si usas el perfil "caddy")
BONSAI_DOMAIN=bonsai.tudominio.com

# Orígenes permitidos para el navegador. En producción, mejor el dominio
# concreto de tu app web en vez de "*".
ALLOWED_ORIGINS=*

# Opcional: cambiar el modelo de visión sin tocar el código
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
